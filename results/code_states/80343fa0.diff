+def objective_factory(train_steps, workers, envs_per_worker):
+    def objective(trial):
+        start = time.time()
+        params = {}
+        for name, spec in get_search_space().items():
+            params[name] = suggest(trial, name, spec)
+        ts = time.strftime("%Y%m%d_%H%M%S")
+        exp = f"hpo_{trial.number}_{ts}"
+        
+        num_layers = params.get("rnn_num_layers", 1)
+        d_model = params["mamba_d_model"]
+        headdim = params["mamba_headdim"]
+        d_state = params["mamba_d_state"]
+        expand = params.get("mamba_expand", 1)
+        
+        d_inner = int(expand * d_model)
+        nheads = d_inner // headdim
+        per_layer = nheads * 32 + nheads * d_state * headdim + nheads * headdim + nheads * headdim
+        rnn_size = max(d_model, per_layer * num_layers)
+        
+        cmd = [sys.executable, "-m", "models.train",
+            "--rnn_type", "mamba3", "--experiment", exp,
+            "--train_for_env_steps", str(train_steps),
+            "--num_workers", str(workers),
+            "--num_envs_per_worker", str(envs_per_worker),
+            "--batch_size", str(2048),
+            "--rollout", "64", "--recurrence", "32",
+            "--save_every_sec", "600", "--keep_checkpoints", "2",
+            "--rnn_size", str(rnn_size),
+            "--rnn_num_layers", str(num_layers),
+            "--mamba_d_model", str(d_model),
+            "--mamba_d_state", str(d_state),
+            "--mamba_headdim", str(headdim),
+            "--mamba_expand", str(expand),
+            "--mamba_chunk_size", str(32),
+            "--learning_rate", str(params["learning_rate"]),
+            "--exploration_loss_coeff", str(params["exploration_loss_coeff"]),
+            "--optimizer", "adam", "--gradient_checkpointing", "False",
+            "--weight_decay", str(params["weight_decay"])]
+        
+        log.info(f"Trial {trial.number}: d_model={d_model} d_state={d_state} "
+                 f"headdim={headdim} layers={num_layers} rnn_size={rnn_size}")
+        
+        train_dir = Path("train_dir") / exp
+        rewards = run_trial_with_watchdog(cmd, train_dir)
+        
+        max_r = max(rewards) if rewards else 0.0
+        mean_r = sum(rewards) / len(rewards) if rewards else 0.0
+        if mean_r <= 0: return 0.0
+        
+        trial.set_user_attr("max_reward", max_r)
+        trial.set_user_attr("elapsed", time.time() - start)
+        return mean_r
+    return objective
