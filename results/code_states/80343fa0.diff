+def watchdog_monitor(log_path, proc, timeout_stuck=300):
+    """Kill subprocess if training is stuck (FPS=0) for >timeout_stuck sec."""
+    path = Path(log_path)
+    last_frame_count = -1
+    stuck_since = None
+    while proc.poll() is None:
+        time.sleep(15)
+        if not path.exists():
+            if stuck_since is None:
+                stuck_since = time.time()
+            elif time.time() - stuck_since > 60:
